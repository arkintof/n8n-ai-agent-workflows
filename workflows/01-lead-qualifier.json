        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "LLM API Key (Authorization: Bearer ...)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\nlet out; try { out = JSON.parse(raw); } catch (e) { out = { error: 'LLM returned non-JSON', raw }; }\nreturn [{ json: { result: out }, pairedItem: 0 }];"
      },
      "id": "49e57291-4ba4-4e83-8382-e256c01eeedc",
