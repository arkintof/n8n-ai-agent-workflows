    {
      "parameters": {
        "jsCode": "const b = $json.body || $json;\nreturn [{ pairedItem: 0, json: { baseUrl: $json.baseUrl, model: $json.model, system: \"You are a B2B sales analyst. Score inbound leads 0-100 for fit and intent using BANT. Return JSON: {score:number, tier:'hot'|'warm'|'cold', summary:string, reasons:string[], next_step:string}.\", user: `Our ICP: ${b.icp || 'SaaS founders, 5-200 employees'}\\nLead form submission:\\n${JSON.stringify(b, null, 2)}` } }];"
      },
      "id": "0ad0d0cb-b8f8-4f58-8ec6-722f73ecda92",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: $json.system }, { role: 'user', content: $json.user } ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "c4d9cefb-cafe-4dc5-9667-d41a4163eddf",
      "name": "LLM",
